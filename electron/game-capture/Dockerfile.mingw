# A MinGW-w64 cross compiler for voicaw-capture.exe on Linux (build-helper.sh). The posix
# variant has std::thread and std::mutex.
FROM debian:12-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++-mingw-w64-x86-64-posix \
    && rm -rf /var/lib/apt/lists/*
